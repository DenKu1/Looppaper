<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Symbols inside the dlls: readable stack traces in the log, no loose .pdb files in publish/. -->
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <!-- Default for local and CI builds; release.yml stamps the tag's version with -p:Version=X.Y.Z. -->
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Authors>DenKu1</Authors>
    <Product>Looppaper</Product>
  </PropertyGroup>
</Project>
